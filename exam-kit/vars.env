# ============================================================
#  EDIT THIS FILE FIRST. Everything else reads from it.
#  Then:  source vars.env
# ============================================================

# --- Azure ---
export LOC="centralindia"
export SUB_ID=""                       # filled by 01-bootstrap.sh if empty

# --- naming prefix (keep short; some names have length limits) ---
export P="lne"

# --- bootstrap (created manually, holds tfstate) ---
export TFSTATE_RG="${P}-tfstate-rg"
export TFSTATE_SA="tfstate$RANDOM$RANDOM"   # 3-24 chars, lowercase+digits ONLY
export TFSTATE_CONTAINER="tfstate"

# --- workload ---
export WORK_RG="rg-${P}-employee-todo"
export VNET="vnet-${P}-employee-todo"
export AKS="aks-${P}-employee-todo"
export PG="psql-${P}-employee-todo"
export VM="vm-${P}-jumphost"
export SPN_NAME="sp-${P}-employee-todo"

# --- Azure DevOps (create org + project manually) ---
export ADO_ORG="galaxyblaster"
export ADO_PROJECT="lne-employee-todo"
export ADO_REPO="lne-employee-todo"
export AGENT_POOL="${P}-vnet-agents"
export AGENT_NAME="${P}-jumphost-agent"
export SERVICE_CONNECTION="${P}-azure-connection"

# --- mandatory tags (policy enforces these) ---
export BU_TAG="Engineering"
export CC_TAG="CC-1001"

# --- network plan ---
export VNET_CIDR="10.0.0.0/16"
export SNET_AKS="10.0.1.0/24"
export SNET_PE="10.0.2.0/24"
export SNET_ACI="10.0.3.0/24"
export SNET_PG="10.0.4.0/24"
export SNET_BASTION="10.0.5.0/26"
export SERVICE_CIDR="10.1.0.0/16"      # MUST NOT overlap VNET_CIDR
export DNS_SERVICE_IP="10.1.0.10"

# --- app source repos ---
export SRC_FRONTEND="https://github.com/cubastion-training/sample-react-app.git"
export SRC_BACKEND="https://github.com/cubastion-training/sample-node-app.git"
export SRC_TODO="https://github.com/a7medayman6/Todo-List-Dockerized-Flask-WebApp"

# --- filled in as you go (03/04 scripts read these) ---
export ACR=""                # from: terraform -chdir=terraform/platform output -raw acr_name
export KV=""                 # from: terraform -chdir=terraform/platform output -raw key_vault_name
export INGRESS_IP=""         # from nginx pipeline
export ACI_IP=""             # from: terraform -chdir=terraform/aci output -raw aci_private_ip
export TAG_FRONTEND=""
export TAG_BACKEND=""
export TAG_TODO=""
